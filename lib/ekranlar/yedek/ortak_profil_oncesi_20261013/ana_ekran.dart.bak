              _YaziCercevesi(ListTile(
                leading: Container(
                  padding: const EdgeInsets.all(8),
                  decoration: BoxDecoration(color: Colors.teal.shade50, borderRadius: BorderRadius.circular(10)),
                  child: const Icon(Icons.badge_outlined, color: Colors.teal),

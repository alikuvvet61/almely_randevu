              _YaziCercevesi(ListTile(
                leading: Container(
                  padding: const EdgeInsets.all(8),
                  decoration: BoxDecoration(color: Colors.indigo.shade50, borderRadius: BorderRadius.circular(10)),
                  child: const Icon(Icons.storefront_outlined, color: Colors.indigo),
                ),
                title: Text(
                  basvuru?['durum'] == 'Bekliyor' ? 'Başvurunuz inceleniyor' : 'İşletmemi ekle',
                  style: const TextStyle(fontWeight: FontWeight.bold),
                ),
                subtitle: Text(
                  basvuru?['durum'] == 'Bekliyor'
                      ? 'Başvurunuz yukarıda. Onay bekliyor.'
                      : basvuru?['durum'] == 'Reddedildi'
                          ? 'Reddedildi. Yeniden yazmak için dokunun.'
                          : 'Vergi numarası ve levha olmadan başvuru olmaz.',
                ),
                trailing: const Icon(Icons.chevron_right),
                onTap: () {
                  Navigator.pop(context);
                  if (basvuru?['durum'] == 'Bekliyor') {
                    _basvuruBekliyorDiyalog(basvuru!);
                  } else {
                    _isletmeBasvurusuAc(userData, basvuru);

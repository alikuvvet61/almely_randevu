          icerik:
              'Evet ise istirahatteki araçları müşteriler “Bugün Çalışan Araçlarımız” listesinde göremez. Hayır ise müşteriler o listede de görür.',
          ikon: Icons.visibility_off,
        ),
        RehberBolum(
          baslik: 'Randevuyu kim onaylasın',
          icerik:

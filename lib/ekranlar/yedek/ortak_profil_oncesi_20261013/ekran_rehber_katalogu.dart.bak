import 'package:flutter/material.dart';

/// Tek bir ekranın kullanım rehberi içeriği.
class EkranRehberIcerik {
  final String baslik;
  final String ozet;
  final List<RehberBolum> bolumler;
  final List<String> ipuclari;
  final List<String> bildirimler;

  const EkranRehberIcerik({
    required this.baslik,
    required this.ozet,
    this.bolumler = const [],
    this.ipuclari = const [],
    this.bildirimler = const [],
  });
}

class RehberBolum {
  final String baslik;
  final String icerik;
  final IconData? ikon;

  const RehberBolum({
    required this.baslik,
    required this.icerik,
    this.ikon,
  });
}

/// Sınıf adı → bu ekrana özel detaylı rehber.
class EkranRehberKatalogu {
  EkranRehberKatalogu._();

  static EkranRehberIcerik getir(String? sinifAdi) {
    if (sinifAdi == null || sinifAdi.isEmpty) return _genel;
    return _harita[sinifAdi] ?? _genelKopya(sinifAdi);
  }

  static bool gizlensinMi(String? sinifAdi) {
    if (sinifAdi == null) return true;
    return sinifAdi.contains('Rehber') ||
        sinifAdi == 'EkranRehberDetayEkrani';
  }

  /// Önce [tercih] ekranının metnine bakar. Yoksa bütün rehberlerde arar.
  static String ara(String soru, {String? tercih}) {
    final kelimeler = soru
        .toLowerCase()
        .split(RegExp(r'[^a-zçğıöşü0-9]+'))
        .where((k) => k.length > 2)
        .toList();
    if (kelimeler.isEmpty) return 'Ne aradığınızı duyamadım.';
    if (tercih != null) {
      final kendi = _enIyiParca(_harita[tercih], kelimeler);
      if (kendi != null) return kendi;
    }
    String? enIyi;
    var enSkor = 0;
    for (final rehber in _harita.values) {
      final parcalar = _parcalar(rehber);
      for (final p in parcalar) {
        final metin = p.toLowerCase();
        var skor = 0;
        for (final k in kelimeler) {
          if (metin.contains(k)) skor++;
        }
        if (skor > enSkor) {
          enSkor = skor;
          enIyi = p;
        }
      }
    }
    if (enIyi == null || enSkor <= 0) {
      return 'Bunu uygulamada bulamadım. Kategori adı, işletme adı, taksi istiyorum, araç kirala veya randevularım diyebilirsiniz.';
    }
    return enIyi;
  }

  static String? _enIyiParca(EkranRehberIcerik? rehber, List<String> kelimeler) {
    if (rehber == null) return null;
    String? enIyi;
    var enSkor = 0;
    for (final p in _parcalar(rehber)) {
      final metin = p.toLowerCase();
      var skor = 0;
      for (final k in kelimeler) {
        if (metin.contains(k)) skor++;
      }
      if (skor > enSkor) {
        enSkor = skor;
        enIyi = p;
      }
    }
    return enSkor > 0 ? enIyi : null;
  }

  static List<String> _parcalar(EkranRehberIcerik rehber) {
    return <String>[
      rehber.ozet,
      for (final b in rehber.bolumler) '${b.baslik}. ${b.icerik}',
      ...rehber.ipuclari,
      ...rehber.bildirimler,
    ].where((p) => p.trim().isNotEmpty).toList();
  }

  static EkranRehberIcerik _genelKopya(String sinif) => EkranRehberIcerik(
        baslik: 'Bu Ekran',
        ozet:
            'Bu sayfa için henüz özel bir rehber tanımlanmamış. Genel kullanım için giriş ekranındaki “Kullanım Rehberi & Yardım”a bakabilirsiniz.',
        bolumler: [
          RehberBolum(
            baslik: 'Ne yapmalıyım?',
            icerik:
                'Ekrandaki buton ve listeleri inceleyin. Takıldığınız yerde destek@almely.com adresine yazabilirsiniz.\n\n(Ekran kodu: $sinif)',
            ikon: Icons.touch_app_outlined,
          ),
        ],
        ipuclari: const [
          'Geri tuşu ile bir önceki ekrana dönebilirsiniz.',
        ],
      );

  static const _genel = EkranRehberIcerik(
    baslik: 'AlmEly Go Hizmet & Randevu',
    ozet:
        'Yerel hizmet sağlayıcılarından randevu alın, taksi çağırın veya araç kiralayın. Her ekranın sağ üstündeki ? düğmesi o ekranı anlatır.',
    bolumler: [
      RehberBolum(
        baslik: 'Başlarken',
        icerik:
            'Telefon numaranızla giriş yapın. SMS doğrulaması sonrası ana sayfadan kategori seçerek ilerleyin.',
        ikon: Icons.login_rounded,
      ),
    ],
    bildirimler: [
      'Randevu onay / red, hatırlatma ve (kira için) süre uzatma bildirimleri telefonunuza gelir.',
      'Bildirim izni kapalıysa kritik uyarıları kaçırabilirsiniz; ayarlardan izin verin.',
    ],
  );

  static final Map<String, EkranRehberIcerik> _harita = {
    'GirisSecimSayfasi': const EkranRehberIcerik(
      baslik: 'Giriş',
      ozet:
          'Telefon numaranızla giriş yaparsınız. Logonun altında “Zamanınız bizim için kıymetli.” yazar. Esnaf numarası tanınırsa (Taksi hariç) Müşteri / Yönetici seçimi gelir.',
      bolumler: [
        RehberBolum(
          baslik: 'Nasıl giriş yapılır?',
          icerik:
              '1. Telefon numaranızı yazın.\n'
              '2. “Giriş Yap”a basın.\n'
              '3. Bu numara ilk kez geliyorsa ad soyad sorulur ve kişi kaydı açılır. SMS gitmez. Aynı numarayla tekrar girince ad sorulmaz.\n'
              '4. Kayıtlı esnafsanız ad sorulmaz: Taksi’de 3 mod (müşteri/sürücü/yönetici); diğer kategorilerde 2 mod (müşteri/yönetici).\n'
              '5. Esnaf değilseniz müşteri ana sayfasına gidersiniz.',
          ikon: Icons.phone_android,
        ),
        RehberBolum(
          baslik: 'Kullanım Rehberi & Yardım',
          icerik:
              'Genel kılavuza buradan ulaşabilirsiniz. Her ekranda ayrıca o ekrana özel ? kısayolu bulunur.',
          ikon: Icons.help_outline,
        ),
        RehberBolum(
          baslik: 'Geliştirme – Hızlı Giriş',
          icerik:
              'Yalnızca geliştirme derlemelerinde görünür. Kayıtlı esnaf kartına dokunarak o numarayla hızlı deneme girişi yapılır. Canlı kullanıcılar bunu görmez.',
          ikon: Icons.developer_mode,
        ),
      ],
      ipuclari: [
        'İlk girişte ad soyad yazılır. SMS şimdilik yok. Aynı numara bir daha ad sormaz.',
        'Telefon alanına yalnızca rakam yazılır. Cep 05xx… veya sabit hat (ör. 0462…) kabul edilir. Harf yazılamaz. Baştaki 0 sayılmaz: 505… ile 0505… aynı numaradır, ikisini ayrı yazmazsınız.',
        'Logo alanına art arda 5 kez dokunmak yönetici girişi içindir (yetkili personel).',
      ],
      bildirimler: [
